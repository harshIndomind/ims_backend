<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>
        <%= invoice.copyTitle %>
    </title>
    <style>
        /* General Body */
        html,
        body {
            font-family: 'Arial', sans-serif;
            color: #333;
            background-color: #ffffff;
        }




        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding: 15px 20px;
            /*background: linear-gradient(90deg, #2980b9 0%, #3498db 100%);*/
            background: #f1f1f1;
            color: #333;
            border-radius: 6px;
        }

        .logo {
            width: 200px;
            min-width: 125px;
            height: auto;
            border-radius: 4px;
            /*background-color: white;*/
            padding: 4px;
        }

        .header-left {
            min-width: 33.3%;
        }

        .header-center {
            min-width: 33.3%;
            text-align: center;
            flex: 1;
        }

        .header-center h2 {
            margin: 0;
            font-size: 22px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
        }

        .header-center p {
            margin-top: 5px;
            font-size: 13px;
            color: #f0f0f0;
        }

        .header-right {
            min-width: 33.3%;
            text-align: right;
            font-size: 12px;
            line-height: 1.4;
        }

        .header-right h4 {
            margin: 0 0 4px;
            font-size: 12px;
            color: #333;
            text-transform: uppercase;
        }

        invoice-info-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 5px;
            margin-bottom: 15px;
            padding: 10px;
            background-color: #fff;
            border: 1px dotted #ccc;
            border-radius: 6px;
        }

        .customer-info {
            width: 70%;
        }

        .invoice-info {
            width: 30%;
            /* background-color: #fafafa; */
            padding: 10px 14px;
            /* border: 1px solid #e0e0e0; */
            border-radius: 4px;
            font-size: 10px;
            line-height: 1.4;
        }

        .invoice-info h4 {
            margin: 0 0 8px 0;
            color: #2c3e50;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            border-bottom: 1px solid #ddd;
            padding-bottom: 3px;
        }

        .info-detail {
            display: flex;
            flex-direction: column;
            gap: 1.5px;
        }

        .invoice-info .info-row {
            display: flex;
            justify-content: space-between;
            padding: 2px 0;
        }

        .invoice-info strong {
            color: #555;
            width: 45%;
            font-weight: 500;
        }

        .invoice-info span {
            width: 55%;
            text-align: right;
            color: #333;
            word-break: break-word;
        }

        /* Customer Info */
        .customer-info {
            width: 40%;
            /* background-color: #fafafa; */
            padding: 10px 14px;
            /*border: 1px solid #e0e0e0; */
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 10px;
            line-height: 1.4;
        }

        .customer-info h4 {
            margin: 0 0 8px 0;
            color: #2c3e50;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            border-bottom: 1px solid #ddd;
            padding-bottom: 3px;
        }

        .customer-detail {
            display: flex;
            flex-direction: column;
            gap: 1.5px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 2px 0;
        }

        .info-row strong {
            color: #555;
            width: 45%;
            font-weight: 500;
        }

        .info-row span {
            width: 55%;
            text-align: right;
            color: #333;
            word-break: break-word;
        }


        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            background-color: #fff;
            box-shadow: 0 0 5px rgba(0, 0, 0, 0.05);
        }

        th,
        td {
            padding: 6px 8px;
            font-size: 10px;
            vertical-align: middle;
            border: 0.2px solid #dcdcdc;
        }

        th {
            background-color: #2980b9;
            color: #fff;
            text-align: center;
        }

        tr:nth-child(even) {
            background-color: #f9fbfc;
        }

        tfoot th {
            background-color: #2980b9;
            font-weight: 600;
        }

        .group-header-row td {
            background-color: #dbe9f5;
            font-weight: 700;
            font-size: 11px;
            text-align: left;
        }

        .group-desc-row td {
            background-color: #f2f7fb;
            font-style: italic;
            font-size: 10px;
            text-align: left;
            color: #555;
        }


        /* Totals */
        .totals {
            margin-top: 15px;
            width: 100%;
        }

        .totals h4,
        .totals h3 {
            text-align: right;
            margin: 5px 0;
            padding-right: 10px;
        }

        .totals h3 {
            color: #e74c3c;
        }

        /* Additional Notes */
        .notes {
            margin-top: 25px;
            background-color: #ecf0f1;
            padding: 15px;
            border-radius: 5px;
        }

        .notes h4 {
            margin: 0 0 5px 0;
            color: #2c3e50;
        }

        .notes p {
            margin: 0 0 10px 0;
            line-height: 1.4;
        }

        /* Footer */
        .footer {
            text-align: center;
            margin-top: 40px;
            font-size: 12px;
            color: #7f8c8d;
        }

        th {
            text-align: center;
            font-weight: bold;
            background-color: #2980b9;
            color: #fff;
            padding: 10px;
        }

        .preview-page {
            background: white;
            margin-bottom: 40px;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        @media print {
            body {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
                background-color: #fff !important;
                margin: 0;
            }

            .header {
                /* background: linear-gradient(90deg, #2980b9 0%, #3498db 100%) !important; */
                background: #f1f1f1 !important;
                color: #333 !important;
                -webkit-print-color-adjust: exact !important;
            }

            th {
                background-color: #2980b9 !important;
                color: #fff !important;
            }

            .preview-page {
                background: none;
                margin: 0;
                padding: 0;
                border-radius: 0;
                box-shadow: none;
                page-break-after: always;
                page-break-inside: auto;
                break-inside: auto;
            }

            .invoice-section,
            .table-scroll,
            .footer-cols,
            .footer-col-left,
            .footer-col-right {
                page-break-inside: auto;
                break-inside: auto;
            }

            .table-scroll {
                overflow: visible;
            }

            tr {
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }

        .table-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table-scroll table {
            min-width: 620px;
        }

        .footer-cols {
            display: flex;
            flex-direction: column;
            margin-top: 20px;
            font-size: 12px;
            gap: 20px;
        }

        .footer-col-left {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            overflow-wrap: break-word;
            border: 1px dotted #ccc;
            border-radius: 4px;
            padding: 10px;
            box-sizing: border-box;
        }

        .footer-col-right {
            width: 100%;
            border: 1px dotted #ccc;
            border-radius: 4px;
            padding: 10px;
            box-sizing: border-box;
            position: relative;
        }

        @media screen and (max-width: 620px) {
            .header {
                flex-direction: column;
                gap: 8px;
                padding: 10px;
            }

            .header-left,
            .header-center,
            .header-right {
                min-width: unset;
                width: 100%;
                text-align: left;
            }

            .logo {
                width: 120px;
                min-width: 80px;
            }

            .info-section {
                flex-direction: column;
            }

            .customer-info {
                width: 100% !important;
                margin-bottom: 0;
                padding: 0;
            }

            .invoice-info {
                width: 100% !important;
                padding: 0;
            }

            .footer-cols {
                flex-direction: column;
                gap: 12px;
            }

            .footer-col-left,
            .footer-col-right {
                width: 100% !important;
            }
        }

        .invoice-section {
            position: relative;
            /* parent for absolute child */
        }

        .watermark {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 120px;
            color: rgba(255, 0, 0, 0.12);
            font-weight: 900;
            pointer-events: none;
            user-select: none;
            z-index: 0;
            /* stays behind content */
        }

        .watermark-draft {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 120px;
            color: rgba(30, 100, 200, 0.10);
            font-weight: 900;
            pointer-events: none;
            user-select: none;
            z-index: 0;
        }
    </style>
</head>

<body>
    <div class="invoice-section">
        <% if (invoice.status === 'draft') { %>
            <div class="watermark-draft">DRAFT</div>
        <% } else if (invoice.paymentStatus === 'CANCELLED') { %>
            <div class="watermark">CANCELLED</div>
        <% } %>
                <div class="header">
                    <div class="header-left">
                        <% if(invoice.businessLogo){ %>
                            <img src="<%= invoice.businessLogo %>" alt="Company Logo" class="logo" />
                            <% }else { %>
                                <img src="https://placehold.co/100x60" alt="Company Logo" class="logo" />
                                <% } %>
                    </div>

                    <div class="header-center">
                        <h2>Work Order</h2>
                    </div>

                    <div class="header-right">
                        <h4>
                            <%= invoice?.business?.org_name ?? '' %>
                        </h4>
                        <p>
                            <% if(invoice?.business?.address) {%>
                                <%- invoice?.business?.address %><br>
                                    <% } %>
                                        <% if(invoice?.business?.org_gst_number) {%>
                                            <strong>GSTIN:</strong> <%- invoice?.business?.org_gst_number %><br>
                                                <% } %>
                                                    <% if(invoice?.business?.org_email) {%>
                                                        <strong>Email:</strong> <%- invoice?.business?.org_email %><br>
                                                            <% } %>
                        </p>
                        <h5><strong>
                                <%= invoice?.copyTitle %>
                            </strong></h5>
                    </div>
                </div>


                <div class="info-section">
                    <div class="customer-info">
                        <h4>Vendor Details</h4>
                        <div class="customer-detail">
                            <div class="info-row">
                                <strong>Name:</strong>
                                <span>
                                    <%= invoice.vendorInfo?.vendor_name || '' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <strong>Address:</strong>
                                <span>
                                    <%= invoice.vendorInfo?.address || '' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <strong>Contact Person:</strong>
                                <span>
                                    <%= invoice.vendorInfo?.contactPerson || '' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <strong>Phone:</strong>
                                <span>
                                    <%= invoice.vendorInfo?.contactNo || '' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <strong>GSTIN:</strong>
                                <span>
                                    <%= invoice.vendorInfo?.gstin || '' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <strong>Place of Supply:</strong>
                                <span>
                                    <%= invoice.vendorInfo?.state_name || '' %>
                                </span>
                            </div>
                        </div>
                    </div>


                    <div class="invoice-info">
                        <h4>Work Order Details</h4>
                        <div class="info-detail">
                            <div class="info-row">
                                <strong>WO No:</strong>
                                <span>
                                    <%= invoice?.combineInvoiceNumber || '' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <strong>WO Date:</strong>
                                <span>
                                    <%= invoice?.woDetail?.date || '' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <strong>Due Date:</strong>
                                <span>
                                    <%= invoice.dueDate || '' %>
                                </span>
                            </div>
                            <% if (invoice.start_date) { %>
                            <div class="info-row">
                                <strong>Start Date:</strong>
                                <span>
                                    <%= invoice.start_date %>
                                </span>
                            </div>
                            <% } %>
                            <% if (invoice.end_date) { %>
                            <div class="info-row">
                                <strong>End Date:</strong>
                                <span>
                                    <%= invoice.end_date %>
                                </span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <p style="font-size:11px; margin:10px 0; line-height:1.5;">
                    <%= invoice.orderReferenceNote %>
                </p>



                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th rowspan="2">Sr. No.</th>
                                <th rowspan="2">Name of Product / Service</th>
                                <th rowspan="2">HSN / SAC</th>
                                <th rowspan="2">Qty</th>
                                <th rowspan="2">UOM</th>
                                <th rowspan="2">Rate</th>
                                <th rowspan="2">Disc. (%)</th>
                                <th rowspan="2">Taxable Value</th>
                                <% if (!invoice.same_state) { %>
                                    <th rowspan="2">IGST %</th>
                                    <th rowspan="2">IGST Amount</th>
                                    <% } else { %>
                                        <th colspan="2">CGST</th>
                                        <th colspan="2">SGST</th>
                                        <% } %>
                                            <th rowspan="2">Amount</th>
                            </tr>
                            <% if (invoice.same_state) { %>
                                <tr>
                                    <th>%</th>
                                    <th>Amount</th>
                                    <th>%</th>
                                    <th>Amount</th>
                                </tr>
                            <% } %>
                        </thead>

                        <tbody>
                            <%
                                // When groupByProductGroup is on, cluster items under a header (group name)
                                // + description row per Product Group (vcp-service ProductGroups, fetched
                                // per-item in work-order.service.js). An item in more than one group is
                                // shown once, under its is_primary-flagged group (set on the product in vcp),
                                // to avoid duplicate/double-counted rows.
                                // Items with no group render as plain rows with no header, same as before.
                                // Groups are lettered in appearance order (A, B, C, ... Z, AA, AB, ...) and
                                // their items numbered A.1, A.2, ... so a multi-line-item product under one
                                // group reads as a cluster instead of just continuing the flat 1,2,3 count.
                                const toLetter = (n) => {
                                    let s = '';
                                    while (n > 0) {
                                        s = String.fromCharCode(65 + ((n - 1) % 26)) + s;
                                        n = Math.floor((n - 1) / 26);
                                    }
                                    return s;
                                };
                                let displayRows = [];
                                if (invoice.groupByProductGroup) {
                                    const groupMap = new Map();
                                    const groupOrder = [];
                                    const ungrouped = [];
                                    invoice.productItems.forEach((item) => {
                                        // A product can belong to more than one group; whichever one is
                                        // flagged is_primary (set on the product's group assignment in vcp)
                                        // is the one used for clustering here. Falls back to array position
                                        // only for legacy data with no primary flag set at all.
                                        const groups = item.product_groups || [];
                                        const group = groups.find((g) => g.is_primary) || groups[0];
                                        if (!group) {
                                            ungrouped.push(item);
                                            return;
                                        }
                                        if (!groupMap.has(group.id)) {
                                            groupMap.set(group.id, { name: group.name, description: group.description, items: [] });
                                            groupOrder.push(group.id);
                                        }
                                        groupMap.get(group.id).items.push(item);
                                    });
                                    groupOrder.forEach((id, groupIndex) => {
                                        const group = groupMap.get(id);
                                        const letter = toLetter(groupIndex + 1);
                                        displayRows.push({ type: 'header', name: `${letter}. ${group.name}`, description: group.description });
                                        group.items.forEach((item, itemIndex) => displayRows.push({ type: 'item', item, label: `${letter}.${itemIndex + 1}` }));
                                    });
                                    ungrouped.forEach((item, index) => displayRows.push({ type: 'item', item, label: String(index + 1) }));
                                } else {
                                    invoice.productItems.forEach((item, index) => displayRows.push({ type: 'item', item, label: String(index + 1) }));
                                }
                                const columnCount = invoice.same_state ? 13 : 11;
                            %>
                            <% displayRows.forEach((row) => { %>
                                <% if (row.type === 'header') { %>
                                    <tr class="group-header-row">
                                        <td colspan="<%= columnCount %>"><%= row.name %></td>
                                    </tr>
                                    <% if (row.description) { %>
                                        <tr class="group-desc-row">
                                            <td colspan="<%= columnCount %>"><%- row.description %></td>
                                        </tr>
                                    <% } %>
                                <% } else { %>
                                    <% const item = row.item; %>
                            <tr>
                                <td style="text-align:center;">
                                    <%= row.label %>
                                </td>

                                <td>
                                    <%= item.product_name || 'N/A' %>
                                        <% if (item?.selectedSerials?.length) { %>
                                            <br><small><strong>Serials:</strong></small><br>
                                            <small><%- item.selectedSerials.join(', ') %></small>
          <% } %>
          <% if (item?.note) { %>
            <br><small><strong>Description:</strong></small><br>
            <small><%= item.note %></small>
          <% } %>
          <% if (item?.specification) { %>
            <br><small><strong>Specification:</strong></small><br>
            <small><em><%- (item.specification || '').replace(/\n/g, '<br>') %></em></small>
          <% } %>
        </td>

        <td style="text-align:center;"><%= item.hsn_sac_code || '' %></td>
        <td style="text-align:center;"><%= item.qty %></td>
        <td style="text-align:center;"><%= item.uomDisplay || '' %></td>
        <td style="text-align:right;"><%= parseFloat(item.price).toFixed(2) %></td>
        <td style="text-align:right;"><%= parseFloat(item.itemDiscountPercentage).toFixed(2) %></td>
        <td style="text-align:right;"><%= parseFloat(item.totalTaxable).toFixed(2) %></td>
        <% if (!invoice.same_state) { %>
            <td style="text-align:right;"><%= parseFloat(item.taxRate).toFixed(2) %></td>
            <td style="text-align:right;"><%= parseFloat(item.igst).toFixed(2) %></td>
        <% } else { %>
            <td style="text-align:right;"><%= parseFloat(item.taxRate).toFixed(2) %></td>
            <td style="text-align:right;"><%= parseFloat(item.cgst).toFixed(2) %></td>
            <td style="text-align:right;"><%= parseFloat(item.taxRate).toFixed(2) %></td>
            <td style="text-align:right;"><%= parseFloat(item.sgst).toFixed(2) %></td>
        <% } %>
        <td style="text-align:right;"><%= parseFloat(item.total).toFixed(2) %></td>
      </tr>
      <% } %>
    <% }) %>
    <!-- 👇 Move total row here -->
  <tr class="total-row">
    <th colspan="2" style="text-align:right;">Total</th>
    <th></th>
    <th style="text-align:right;"></th>
    <th></th>
    <th></th>
    <th style="text-align:right;"><%= parseFloat(invoice.totalDiscountAmount).toFixed(2) %></th>
    <th style="text-align:right;"><%= parseFloat(invoice.total_taxable).toFixed(2) %></th>
    <% if (!invoice.same_state) { %>
      <th></th>
      <th style="text-align:right;"><%= parseFloat(invoice.totalIgst).toFixed(2) %></th>
    <% } else { %>
      <th></th>
      <th style="text-align:right;"><%= parseFloat(invoice.totalCgst).toFixed(2) %></th>
      <th></th>
      <th style="text-align:right;"><%= parseFloat(invoice.totalSgst).toFixed(2) %></th>
    <% } %>
    <% if (!invoice.same_state) { %>
      <th style="text-align:right;"><%= parseFloat(invoice.totalTaxableAmount+invoice.totalIgst).toFixed(2) %></th>
    <% } else { %>
      <th style="text-align:right;"><%= parseFloat(invoice.totalTaxableAmount+invoice.totalCgst+invoice.totalSgst).toFixed(2) %></th>
    <% } %>
  </tr>
  </tbody>
</table>
</div>

    <div class="footer-cols">
    <!-- Right Column -->
    <div class="footer-col-right">
        <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:8px;">
            <div>
                <strong>Taxable Amount</strong><br>
                <%= parseFloat(invoice.totalTaxableAmount).toFixed(2) %>
            </div>

            <% if (!invoice.same_state) { %>
                <div>
                    <strong>Add : IGST</strong><br>
                    <%= parseFloat(invoice.totalIgst).toFixed(2) %>
                </div>
                <% } else { %>
                    <div>
                        <strong>Add : CGST</strong><br>
                        <%= parseFloat(invoice.totalCgst).toFixed(2) %>
                    </div>
                    <div>
                        <strong>Add : SGST</strong><br>
                        <%= parseFloat(invoice.totalSgst).toFixed(2) %>
                    </div>
                    <% } %>

                        <div>
                            <strong>Total Tax</strong><br>
                            <%= parseFloat(invoice.total_tax).toFixed(2) %>
                        </div>

                        <div style="color:#e74c3c;">
                            <strong>Total WO Amount</strong><br>
                            ₹ <%= parseFloat(invoice.grandTotal).toFixed(2) %>
                        </div>
        </div>

                    <% if (invoice.charges && invoice.charges.length > 0) { %>
                        <% invoice.charges.forEach((charge) => { %>
                            <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                <span><strong>
                                        <%= charge.name %>
                                        <%= charge.calculationType==='PERCENTAGE' ? `(${charge.value}%)` : '' %>
                                    </strong></span>
                                <span>
                                    <% if (charge.operation=='-' ) { %>-<% } %>
                                    <%= parseFloat(charge.taxableAmount).toFixed(2) %>
                                </span>
                            </div>
                        <% }); %>
                    <% } %>

    </div>

    <!-- Left Column -->
    <div class="footer-col-left">
        <!-- Bank Details -->
        <!-- <div style="border-bottom:1px dotted #ccc; padding-bottom:6px; margin-bottom:8px; font-weight:bold;">
            Bank Details
        </div>
        <div style="margin-bottom:4px;"><strong>Bank Name:</strong> <%= invoice?.bankSnapshot?.bank_name || ' N/A' %>
                </div>
                <div style="margin-bottom:4px;"><strong>Account Holder Name:</strong>
                    <%= invoice?.bankSnapshot?.account_name || 'N/A' %>
                </div>
                <div style="margin-bottom:4px;"><strong>Account No:</strong>
                    <%= invoice?.bankSnapshot?.account_no || 'N/A' %>
                </div>
                <div style="margin-bottom:8px;"><strong>IFSC:</strong>
                    <%= invoice?.bankSnapshot?.bank_ifsc || 'N/A' %>
                </div> -->

        <!-- Terms & Conditions -->
        <% if (invoice.termsAndConditions && invoice.termsAndConditions.length > 0) { %>
            <div style="font-size:11px; line-height:1.6;">
                <div style="font-weight:bold;"><h3>Terms &amp; Conditions</h3></div>
                <% invoice.termsAndConditions.forEach((term) => { %>
                    <div style="margin-top:4px; margin-left:8px;">
                        <div style="font-weight:bold;"><%= term.label %>:</div>
                        <div><%= term.value %></div>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <!-- Additional Notes -->
        <% if (invoice.additionalNotes && invoice.additionalNotes.length > 0) { %>
            <% invoice.additionalNotes.forEach((item) => { %>
                <% if (item.title && item.title.trim() !== '' && item.detail && item.detail.trim() !== '') { %>
                    <div style="border-top:1px dotted #afafaf; margin-top:8px; padding-top:6px; font-size:11px;">
                        <div style="font-weight:bold;"><h3><%= item.title %></h3></div>
                        <div style="margin-top:4px;">
                        <div style="margin-top:4px; font-size:11px; line-height:1.6;">
                        <%- item.detail
    .replace(/<p\b([^>]*)>/gi, (match, attrs) => {
        if (attrs.includes('style=')) {
            return match.replace(
                /style="([^"]*)"/i,
                'style="$1; margin:0 !important; padding:0 !important; line-height:1.2;"'
            );
        }

        return `<p${attrs} style="margin:0 !important; padding:0 !important; line-height:1.2;">`;
    })
%>
                    </div>
                                        </div>
                                    </div>
                                    <% } %>
                                <% }) %>
                            <% } %>
    </div>
    </div>

    <!-- Footer Note -->
    <div style="margin-top:40px; color:#333; font-size:10px; width:100%; box-sizing:border-box; padding-bottom:20px;">
        <!-- Company Name -->
        <div style="text-align:right; font-weight:bold; margin-bottom:40px;">
            For <%= invoice?.business?.org_name ?? '' %>
        </div>

        <!-- Prepared By / Checked By / Authorized Signatory -->
        <div style="display:flex; justify-content:space-between; margin-bottom:50px;">
            <div>Prepared By</div>
            <div>Checked By</div>
            <div>Authorized Signatory</div>
        </div>

        <!-- Receiver's Signature -->
        <div style="text-align:left;">
            Receiver's Signature &amp; Seal with Date
        </div>
    </div>

    <!-- <div class="footer">
                    <p>Thank you for your business!</p>
                </div> -->
    </div>

</body>

</html>
