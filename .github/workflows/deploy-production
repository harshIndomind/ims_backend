name: Deploy Production Indomind Vendor Backend to EC2

on:
  push:
    branches: [master]

jobs:
  backup-ec2-code:
    if: github.ref == 'refs/heads/master'
    runs-on: ubuntu-latest
    environment: production

    steps:
      - name: Setup SSH Key
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.EC2_KEY }}" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa

          if [ -z "${{ secrets.EC2_HOST }}" ]; then
            echo "❌ EC2_HOST is not set!"
            exit 1
          fi

          ssh-keyscan -H ${{ secrets.EC2_HOST }} >> ~/.ssh/known_hosts

      - name: SSH & Backup Current App on EC2
        run: |
          ssh ${{ secrets.EC2_USERNAME }}@${{ secrets.EC2_HOST }} "APP_DIR='${{ secrets.APP_DIR }}' bash -s" << 'EOF'
            set -e
            echo "📦 Backing up from ${{ secrets.APP_DIR }}"
            [ -z ${{ secrets.APP_DIR }} ] && echo "❌ APP_DIR is empty" && exit 1
            rm -rf ~/ims-backup-prod
            mkdir -p ~/ims-backup-prod
            cp -a ${{ secrets.APP_DIR }}/* ~/ims-backup-prod/
            echo "✅ Backup completed"
          EOF

  sync-code-to-ec2:
    needs: backup-ec2-code
    runs-on: ubuntu-latest
    environment: production

    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Setup SSH Key
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.EC2_KEY }}" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
          ssh-keyscan -H ${{ secrets.EC2_HOST }} >> ~/.ssh/known_hosts

      - name: Rsync Code to EC2
        run: |
          rsync -avz --delete \
            --exclude='.git' \
            --exclude='.github' \
            --exclude='.env*' \
            --exclude='src/uploads' \
            . ${{ secrets.EC2_USERNAME }}@${{ secrets.EC2_HOST }}:${{ secrets.APP_DIR }}

  deploy-to-ec2:
    needs: sync-code-to-ec2
    runs-on: ubuntu-latest
    environment: production

    steps:
      - name: Setup SSH Key
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.EC2_KEY }}" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
          ssh-keyscan -H ${{ secrets.EC2_HOST }} >> ~/.ssh/known_hosts

      - name: SSH & Deploy with Rollback on Failure
        run: |
          ssh ${{ secrets.EC2_USERNAME }}@${{ secrets.EC2_HOST }} "APP_DIR='${{ secrets.APP_DIR }}' bash -s" << 'EOF'
            set -e
          
            export NVM_DIR="$HOME/.nvm"
            [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm

            cd ${{ secrets.APP_DIR }}
            nvm use 22
          
            echo "🚀 Starting deployment..."
                    
            if ! npm ci --legacy-peer-deps; then
              echo "❌ NPM install failed! Rolling back..."
              rm -rf ./*
              cp -a ~/ims-backup-prod/. .
              pm2 delete ims-backend-prod || true
              pm2 start ecosystem.config.js --only ims-backend-prod
              pm2 save
              sudo systemctl restart nginx
              exit 1
            fi
          
            pm2 delete ims-backend-prod || true
            if ! pm2 start ecosystem.config.js --only ims-backend-prod; then
              echo "❌ PM2 start failed! Rolling back..."
              rm -rf ./*
              cp -a ~/ims-backup-prod/. .
              pm2 delete ims-backend-prod || true
              pm2 start ecosystem.config.js --only ims-backend-prod
              pm2 save
              sudo systemctl restart nginx
              exit 1
            fi
          
            pm2 save
            sudo systemctl restart nginx
            echo "✅ Deployment successful"
          EOF

